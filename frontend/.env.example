# Adresse de base de l'API backend, lue par Vite au moment du BUILD.
#
# Dev  : laisser cette variable VIDE ou non définie -> le frontend tape
#        directement le backend NestJS sur http://localhost:5000 (cross-origin).
# Prod : le build est lancé avec VITE_API_URL="" (voir nginx/Dockerfile),
#        ce qui produit des URLs *relatives* (même origine), proxifiées vers
#        le backend par nginx. Aucun hôte en dur -> marche en LAN, domaine, etc.
#
# Note : seules les variables préfixées par VITE_ sont exposées au frontend.
#        L'ancien REACT_APP_* (Create React App) est ignoré par Vite.
VITE_API_URL=http://localhost:5000

# =============================================================
# DATABASE
# These match the service config — leave as-is.
# Except DB_PASSWORD: change it for a real deployment.
# =============================================================
DB_HOST=database
DB_PORT=5432
DB_NAME=safeschool
DB_USER=postgres
DB_PASSWORD=changeme

# ============================================================
# BACKEND
# Internal port, and frontend origin(s) allowed by CORS
# (comma-separated for several; unused in prod — nginx is same-origin).
# ============================================================
BACKEND_PORT=3000
FRONTEND_URL=http://localhost:5173

# ============================================================
# AUTH — JWT signing secret
# Weak value here is intentional — acceptable here.
# To generate a real one: openssl rand -hex 32
# ============================================================
JWT_SECRET=change_me

# ============================================================
# FRONTEND (Vite)
# Maps to the host-exposed port.
# ============================================================
VITE_API_URL=http://localhost:5000
# Override if socket runs on different host:
# VITE_SOCKET_URL=

# ============================================================
# AI SCORING (Groq)
# Get a key at console.groq.com, or set AI_ENABLED=false.
# ============================================================
GROQ_API_KEY=
AI_ENABLED=true

# ============================================================
# LOGGING (ELK)
# These match the service config — leave as-is.
# LOG_LEVEL is yours to tune (error/warn/info/debug).
# ============================================================
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5044
LOG_LEVEL=info
